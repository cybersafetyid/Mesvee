{
  "identifier": "main",
  "description": "Capabilities for the trusted Mesvee shell webview only. Service webviews have different labels and therefore inherit none of these permissions.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-bootstrap",
    "allow-app-ready",
    "allow-update-settings",
    "allow-reset-preferences",
    "allow-window-minimize",
    "allow-window-toggle-maximize",
    "allow-window-is-maximized",
    "allow-window-close",
    "allow-quit-app",
    "allow-open-external",
    "allow-open-folder",
    "allow-send-test-notification",
    "allow-log-frontend",
    "allow-security-status",
    "allow-enable-lock",
    "allow-disable-lock",
    "allow-lock-app",
    "allow-unlock-app",
    "allow-change-pin",
    "allow-reset-pin-with-recovery",
    "allow-regenerate-recovery",
    "allow-add-service",
    "allow-remove-service",
    "allow-set-active-service",
    "allow-reorder-services",
    "allow-set-service-muted",
    "allow-set-service-zoom",
    "allow-sync-workspace",
    "allow-service-navigate",
    "allow-clear-service-data",
    "allow-check-for-update",
    "allow-install-update",
    "allow-export-diagnostics"
  ]
}
